# ---------------------------------------------------------------------------
# Maal Help environment configuration. Copy to `.env` and adjust.
# Secrets in this file are read ONLY by the server; nothing here is shipped to
# the browser bundle (the web client never reads process.env).
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# Public origin of the web app (used for CSRF origin checks and links)
APP_ORIGIN=http://localhost:5173

# Database. Leave DATABASE_URL empty in development to use the embedded
# PostgreSQL engine (PGlite) stored in PGLITE_DIR. Set it for managed Postgres.
DATABASE_URL=
PGLITE_DIR=./.data/pg
DB_POOL_MAX=10

# Session + crypto. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=change-me-dev-only-session-secret-32chars
# 32-byte base64 key used for AES-256-GCM encryption of integration credentials
ENCRYPTION_KEY=
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Mistral AI (server-side only)
MISTRAL_API_KEY=
MISTRAL_API_URL=https://api.mistral.ai/v1
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_TIMEOUT_MS=20000
MISTRAL_MAX_RETRIES=2
# Requests per minute per tenant for AI endpoints
AI_RATE_LIMIT_PER_MINUTE=20
# USD per 1M tokens, used for AI cost tracking
AI_COST_INPUT_PER_MTOK=0.1
AI_COST_OUTPUT_PER_MTOK=0.3

# File storage: "local" (STORAGE_DIR) or "s3" (any S3-compatible endpoint)
STORAGE_DRIVER=local
STORAGE_DIR=./.data/uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=15

# Background jobs run in-process against the Postgres-backed queue.
JOBS_ENABLED=true
JOBS_POLL_MS=5000
DAILY_BRIEFING_HOUR=7

# Notifications. "log" providers write to the server log in development.
EMAIL_PROVIDER=log
SMTP_URL=
EMAIL_FROM=Maal Help <no-reply@maalhelp.local>
WHATSAPP_PROVIDER=log
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

LOG_LEVEL=info
# Seed the demo company on first boot (development only)
SEED_DEMO=true
